  "cards": [
    {
      "dot": "cyan",
      "title": "Wire protocol (one WebSocket)",
      "items": [
        "Text frames: JSON control — hello, config, cursor, cursorShape, clip, state, quality, fit, pong",
        "Client → Mac: move / mrel / btn / scroll / key / text / setclip / audio / fit / ping / stats",
        "Binary type 1: video [1][key flag][µs ts][AVCC access unit]",
        "Binary type 2: audio [2][AAC=1 | PCM=2][µs ts][payload]",
        "Device name rides on /ws?device= for connect notices"
      ]
    },
    {
      "dot": "emerald",
      "title": "Video pipeline",
      "items": [
        "ScreenCaptureKit at the display's pixel size, scaled to the quality ladder, cursor excluded",
        "VideoToolbox real-time encode, low-latency rate control, no B-frames, keyframe every 10 s or on demand",
        "HEVC only when every viewer can decode it (lifts the 4K cap); otherwise H.264",
        "Max 3 frames in flight per viewer: a slow viewer skips to the next keyframe instead of lagging",
        "Idle screen: last frame is re-encoded as a keyframe so new viewers see it instantly"
      ]
    },
    {
      "dot": "violet",
      "title": "Auto quality",
      "items": [
        "Every second: worst viewer's RTT, decoder queue and dropped frames",
        "Congested → bitrate × 0.7; stuck at the floor 2 s → step resolution down",
        "Clear 5 s → bitrate × 1.15; at max for 10 s → step resolution up",
        "Ladder: 1280 · 1600 · 1920 · 2560 · 3840 wide; Fast / Balanced / Sharp override it"
      ]
    },
    {
      "dot": "rose",
      "title": "Who can connect",
      "items": [
        "Reachable only inside your tailnet — the agent binds 127.0.0.1 and is published by tailscale serve",
        "tailscale serve stamps the verified Tailscale-User-Login; anything not allowlisted gets 403",
        "Optional passkey lock: Face ID / Touch ID → HMAC-signed 12 h cookie required for /ws, files and uploads",
        "New passkeys only during a 10-minute window opened from the Mac's menu bar"
      ]
    },
    {
      "dot": "amber",
      "title": "Files & clipboard",
      "items": [
        "Browse and download only inside ~/Downloads and ~/Desktop (.. and symlink escapes rejected)",
        "Uploads stream to ~/Downloads with non-clobbering names",
        "Folder-access prompts are checked on a background thread so nothing blocks waiting for consent",
        "Pasteboard polled every 0.5 s; text from a viewer is written without echoing back"
      ]
    },
    {
      "dot": "orange",
      "title": "Around the core",
      "items": [
        "PowerManager wakes the display on connect and holds it awake while anyone is viewing",
        "Lock / display-sleep state shown as a banner with a Wake button",
        "Menu bar: QR code, active sessions, Disconnect all, passkey controls, permission status",
        "Connect notices via UserNotifications: “iPhone connected — you@example.com”"
      ]
    },
    {
      "dot": "slate",
      "title": "Install & run",
      "items": [
        "scripts/setup.sh (this Mac or --remote over SSH) → build → sign → install-agent.sh",
        "Signed with a stable self-made identity so Screen Recording / Accessibility survive updates",
        "LaunchAgent com.tether.agent: starts at login, restarts if it exits",
        "Logs: ~/Library/Logs/Tether.log"
      ]
    }
  ]
}