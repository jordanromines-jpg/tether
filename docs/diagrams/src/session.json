  "cards": [
    {
      "dot": "rose",
      "title": "Gates, in order",
      "items": [
        "tailscale serve: only tailnet devices reach the Mac; adds the verified Tailscale-User-Login",
        "Identity gate: logins not on the allowlist get 403 before any route runs",
        "Passkey gate (optional): /ws, files and uploads also need a valid 12 h HMAC cookie"
      ]
    },
    {
      "dot": "violet",
      "title": "What “check signature” verifies",
      "items": [
        "One-time challenge, expires after 2 minutes",
        "Origin + relying-party hash match this Mac's ts.net name",
        "User-verification flag set (Face ID / Touch ID actually used)",
        "P-256 ECDSA over authenticatorData ‖ SHA-256(clientData)"
      ]
    },
    {
      "dot": "amber",
      "title": "Enrolling a passkey",
      "items": [
        "Only while the Mac's menu-bar enrollment window is open (10 min)",
        "Stops a stolen-but-signed-in device registering its own passkey",
        "Cookie is HttpOnly · Secure · SameSite=Strict, bound to the login"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hello handshake",
      "items": [
        "Mac → device: displays, permissions, locked/asleep state, fit-to-device availability",
        "Device → Mac: decodable codecs (HEVC probed first), quality preset, preferred display",
        "Mac shows “iPhone connected” and holds the display awake while anyone views"
      ]
    },
    {
      "dot": "cyan",
      "title": "Codec choice",
      "items": [
        "HEVC only when every connected viewer can decode it; otherwise H.264",
        "HEVC lifts the 4K cap so 5K/6K displays stream at native size",
        "A config message (codec string + hvcC/avcC) always precedes a keyframe"
      ]
    },
    {
      "dot": "slate",
      "title": "Instant first picture",
      "items": [
        "ScreenCaptureKit only delivers frames when the screen changes",
        "On join, the last captured frame is re-encoded as a keyframe",
        "Capture excludes the cursor; clients draw it locally"
      ]
    },
    {
      "dot": "violet",
      "title": "Auto quality (every second)",
      "items": [
        "Worst viewer's RTT, decoder queue and frames dropped for backpressure",
        "Congested → bitrate × 0.7; stuck at the floor 2 s → one resolution step down",
        "Clear 5 s → bitrate × 1.15; at max 10 s → one step up (1280 → 3840 wide)",
        "Fast / Balanced / Sharp override it"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cursor & input",
      "items": [
        "Desktop: Mac cursor shape becomes the real CSS cursor (zero lag)",
        "Touch: overlay predicted from your finger, corrected at 60 Hz",
        "Double/triple-click derived from timing on the Mac",
        "⌘ combos sent as taps; 3-finger swipes → Spaces / Mission Control / App Exposé"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backpressure",
      "items": [
        "≤3 video frames in flight per viewer",
        "A slow viewer skips to the next keyframe instead of building latency",
        "One capture feeds every viewer"
      ]
    },
    {
      "dot": "orange",
      "title": "Clipboard",
      "items": [
        "Mac pasteboard polled every 0.5 s; new text shows a Copy toast",
        "Text from your device is written without echoing back",
        "Send & paste: writes the pasteboard, then ⌘V"
      ]
    },
    {
      "dot": "amber",
      "title": "Sound",
      "items": [
        "Starts on a tap (browsers require a gesture)",
        "AAC-LC 48 kHz via WebCodecs AudioDecoder, or 24 kHz PCM where it's missing",
        "~80 ms jitter buffer that resyncs if it drifts"
      ]
    },
    {
      "dot": "slate",
      "title": "Teardown",
      "items": [
        "Every key and button released when a viewer leaves",
        "Capture, cursor and clipboard polling stop with the last viewer",
        "Fit-to-device virtual display removed; awake hold released"
      ]
    }
  ]
}