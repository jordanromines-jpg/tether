  "cards": [
    {
      "dot": "rose",
      "title": "How it talks to you",
      "items": [
        "✓ done · → working · ✗ real error (exit 1, with the reason and the log path)",
        "ACTION NEEDED (exit 3): one plain-language step for the person at the Mac",
        "Run the same command again — finished steps are skipped, the build too if nothing changed"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two modes",
      "items": [
        "scripts/setup.sh — make this Mac controllable",
        "scripts/setup.sh --remote user@mac [--key …] [--name …] — install on another Mac over SSH (build here, same chip type)",
        "scripts/setup.sh --check — read-only report of what's done and what's left"
      ]
    },
    {
      "dot": "amber",
      "title": "Things it never does for you",
      "items": [
        "Type passwords (ssh-copy-id and the Xcode license prompt are yours)",
        "Flip Screen Recording / Accessibility (macOS requires a person)",
        "Enable HTTPS without explaining the public certificate log first"
      ]
    },
    {
      "dot": "emerald",
      "title": "After setup",
      "items": [
        "Updates: scripts/setup.sh again, or scripts/deploy.sh <name> for another Mac",
        "LaunchAgent com.tether.agent restarts Tether if it exits",
        "Phone: install Tailscale, same account, scan the QR code, Add to Home Screen"
      ]
    }
  ]
